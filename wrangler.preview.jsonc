{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corp-merch-eu-preview",
  "main": "src/_worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  }
}
